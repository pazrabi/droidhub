[Unit]
Description=Phone Hub Service
After=network.target tailscaled.service
Wants=network.target

[Service]
Type=exec
User=hub
Group=hub
WorkingDirectory=/opt/phone-hub
EnvironmentFile=/opt/phone-hub/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/phone-hub/venv/bin/uvicorn hub.main:create_app --factory --host 127.0.0.1 --port 8090
Restart=always
RestartSec=5
MemoryMax=600M

# Security and Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictNamespaces=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
ReadWritePaths=/opt/phone-hub/data /opt/phone-hub/config

[Install]
WantedBy=multi-user.target
